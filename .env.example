# The browser calls only this site's own server proxy (/_s/*). Leave unset unless testing something else.
# VITE_API_BASE_URL=/_s

# Server-side only (no VITE_ prefix: never in the browser bundle). Put real values in .env.local locally
# and in the deployment's environment settings; never commit them.
# The Master server, e.g. https://api.master-admin.onelocal.co (local: http://localhost:8000).
MASTER_SERVER_URL=http://localhost:8000
# This site's key on the Master server (same value as INTERNAL_KEY_ADMIN_WEB there; openssl rand -hex 32).
INTERNAL_KEY_ADMIN_WEB=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/bundle-secret-scan.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/_s/:path*",
      "destination": "/api/proxy?__mp=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/proxy.ts": {
      "maxDuration": 30
    }
  },
  "regions": [
    "bom1"
  ]
}
